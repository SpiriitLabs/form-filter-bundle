{
    "name": "spiriitlabs/form-filter-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for dynamic filtering, search forms and Doctrine query generation",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "form",
        "filter",
        "search",
        "search-form",
        "doctrine",
        "doctrine-orm",
        "query-builder",
        "criteria",
        "listing",
        "datatable",
        "dynamic-filter",
        "admin",
        "backoffice"
    ],
    "homepage": "https://github.com/SpiriitLabs/form-filter-bundle",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "doctrine/orm": "^3.0",
        "symfony/deprecation-contracts": "^3.5",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/framework-bundle": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "doctrine/annotations": "^2.0",
        "doctrine/doctrine-bundle": "^1.8 || ^2.0 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "rector/rector": "^2.0",
        "symfony/phpunit-bridge": "^6.4|^7.4|^8.0",
        "symfony/var-dumper": "^6.4|^7.4|^8.0",
        "symfony/var-exporter": "^6.4|^7.4|^8.0",
        "symfony/web-profiler-bundle": "^6.4|^7.4|^8.0",
        "symfony/yaml": "^6.4|^7.4|^8.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "symfony/web-profiler-bundle": "To inspect in the web debug toolbar which form field produced which DQL condition"
    },
    "autoload":     {
        "psr-4": { "Spiriit\\Bundle\\FormFilterBundle\\": "" }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "vendor/bin/simple-phpunit"
        ]
    }
}
